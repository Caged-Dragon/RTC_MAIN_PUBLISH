# Public Supabase project URL used by the website's read-only catalogue client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Use the project's publishable/anon key only. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Canonical public website origin.
NEXT_PUBLIC_SITE_URL=https://rtcrackers.com

# Supabase query revalidation interval in seconds.
CMS_REVALIDATE_SECONDS=60
